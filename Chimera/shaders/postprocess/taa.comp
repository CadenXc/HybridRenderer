#version 460
#include "ShaderCommon.h"

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 2, binding = 0) uniform sampler2D curColor;
layout(set = 2, binding = 1) uniform sampler2D historyColor;
layout(set = 2, binding = 2) uniform sampler2D gMotion;
layout(set = 2, binding = 3) uniform sampler2D gDepth;
layout(set = 2, binding = 4) uniform sampler2D historyDepth;

layout(set = 2, binding = 5, rgba16f) uniform image2D outFinal;

// --- Helper Functions ---
vec3 RGBToYCoCg(vec3 rgb) 
{
    float y  =  0.25 * rgb.r + 0.5 * rgb.g + 0.25 * rgb.b;
    float co =  0.5  * rgb.r - 0.5 * rgb.b;
    float cg = -0.25 * rgb.r + 0.5 * rgb.g - 0.25 * rgb.b;
    return vec3(y, co, cg);
}

vec3 YCoCgToRGB(vec3 ycocg) 
{
    float r = ycocg.x + ycocg.y - ycocg.z;
    float g = ycocg.x + ycocg.z;
    float b = ycocg.x - ycocg.y - ycocg.z;
    return vec3(r, g, b);
}

// HDR Compression to suppress fireflies
vec3 ToneMap(vec3 color) 
{
    // Handle potential NaNs or negatives
    if (any(isnan(color)) || any(isinf(color))) return vec3(0.0);
    color = max(color, vec3(0.0));
    
    return color / (1.0 + max(color.r, max(color.g, color.b)));
}

vec3 UnToneMap(vec3 color) 
{
    // Inverse of ToneMap with a safe epsilon
    float lum = max(color.r, max(color.g, color.b));
    return color / max(1.0 - lum, 0.0001);
}

ivec2 ClampPixel(ivec2 pixel, ivec2 extent)
{
    return clamp(pixel, ivec2(0), extent - ivec2(1));
}

vec3 ReconstructWorldPosition(float depth, vec2 uv)
{
    const vec4 clip = vec4(uv * 2.0 - 1.0, depth, 1.0);
    const vec4 world = camera.viewProjInverse * clip;
    return world.xyz / world.w;
}

vec3 SampleHistoryCatmullRom(vec2 uv)
{
    const vec2 extent = vec2(textureSize(historyColor, 0));
    const vec2 samplePosition = uv * extent;
    const vec2 texelPosition1 = floor(samplePosition - 0.5) + 0.5;
    const vec2 f = samplePosition - texelPosition1;

    const vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    const vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    const vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    const vec2 w3 = f * f * (-0.5 + 0.5 * f);
    const vec2 w12 = w1 + w2;

    const vec2 texelPosition0 = texelPosition1 - 1.0;
    const vec2 texelPosition12 = texelPosition1 + w2 / w12;
    const vec2 texelPosition3 = texelPosition1 + 2.0;

    const vec2 minPosition = vec2(0.5);
    const vec2 maxPosition = extent - vec2(0.5);
    const vec2 uv0 = clamp(texelPosition0, minPosition, maxPosition) / extent;
    const vec2 uv12 = clamp(texelPosition12, minPosition, maxPosition) / extent;
    const vec2 uv3 = clamp(texelPosition3, minPosition, maxPosition) / extent;

    vec3 result = vec3(0.0);
    result += texture(historyColor, vec2(uv0.x, uv0.y)).rgb * w0.x * w0.y;
    result += texture(historyColor, vec2(uv12.x, uv0.y)).rgb * w12.x * w0.y;
    result += texture(historyColor, vec2(uv3.x, uv0.y)).rgb * w3.x * w0.y;
    result += texture(historyColor, vec2(uv0.x, uv12.y)).rgb * w0.x * w12.y;
    result += texture(historyColor, vec2(uv12.x, uv12.y)).rgb * w12.x * w12.y;
    result += texture(historyColor, vec2(uv3.x, uv12.y)).rgb * w3.x * w12.y;
    result += texture(historyColor, vec2(uv0.x, uv3.y)).rgb * w0.x * w3.y;
    result += texture(historyColor, vec2(uv12.x, uv3.y)).rgb * w12.x * w3.y;
    result += texture(historyColor, vec2(uv3.x, uv3.y)).rgb * w3.x * w3.y;
    return result;
}

bool IsDepthHistoryConsistent(vec2 currentUv, vec2 previousUv,
                              float currentDepth)
{
    if (any(lessThan(previousUv, vec2(0.0))) ||
        any(greaterThan(previousUv, vec2(1.0))))
    {
        return false;
    }

    const ivec2 historyExtent = textureSize(historyDepth, 0);
    const ivec2 historyPixel =
        ClampPixel(ivec2(previousUv * vec2(historyExtent)), historyExtent);
    const float previousDepth = texelFetch(historyDepth, historyPixel, 0).r;

    // Reversed-Z clear depth represents the infinitely distant background.
    if (currentDepth <= 1e-6)
    {
        return previousDepth <= 1e-4;
    }

    const vec3 worldPosition =
        ReconstructWorldPosition(currentDepth, currentUv);
    const vec4 previousClip =
        camera.prevProj * camera.prevView * vec4(worldPosition, 1.0);
    if (previousClip.w <= 1e-6)
    {
        return false;
    }

    const float expectedPreviousDepth = previousClip.z / previousClip.w;
    const float tolerance = max(1e-4, abs(expectedPreviousDepth) * 0.01);
    return abs(previousDepth - expectedPreviousDepth) <= tolerance;
}

// Standard AABB Clipping using ray-box intersection (Reference project style)
vec3 ClipHistory(vec3 history, vec3 boxMin, vec3 boxMax)
{
    vec3 filtered = (boxMin + boxMax) * 0.5;
    vec3 rayOrigin = history;
    vec3 rayDir = filtered - history;
    
    // Safety against division by zero
    rayDir.x = abs(rayDir.x) < 0.00001 ? 0.00001 : rayDir.x;
    rayDir.y = abs(rayDir.y) < 0.00001 ? 0.00001 : rayDir.y;
    rayDir.z = abs(rayDir.z) < 0.00001 ? 0.00001 : rayDir.z;
    
    vec3 invRayDir = 1.0 / rayDir;
    vec3 intersectMin = (boxMin - rayOrigin) * invRayDir;
    vec3 intersectMax = (boxMax - rayOrigin) * invRayDir;
    
    vec3 enterIntersect = min(intersectMin, intersectMax);
    float t = clamp(max(enterIntersect.x, max(enterIntersect.y, enterIntersect.z)), 0.0, 1.0);
    
    return mix(history, filtered, t);
}

void main() 
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= displayData.x || pixel.y >= displayData.y) return;

    vec2 uv = (vec2(pixel) + 0.5) / displayData.xy;
    
    if ((frameData.w & RENDER_FLAG_TAA_BIT) == 0) 
    {
        vec3 currentRGB = texelFetch(curColor, pixel, 0).rgb;
        imageStore(outFinal, pixel, vec4(currentRGB, 1.0));
        return;
    }

    // 1. Velocity Dilation (Find closest point to camera in 3x3)
    const ivec2 depthExtent = textureSize(gDepth, 0);
    ivec2 closestPixel = pixel;
    float closestDepth = 0.0; // In Reversed-Z, 1.0 is near, 0.0 is far. We seek the maximum value.
    for (int y = -1; y <= 1; ++y)
    {
        for (int x = -1; x <= 1; ++x)
        {
            const ivec2 samplePixel =
                ClampPixel(pixel + ivec2(x, y), depthExtent);
            float d = texelFetch(gDepth, samplePixel, 0).r;
            if (d > closestDepth) { closestDepth = d; closestPixel = samplePixel; }
        }
    }

    // 2. Sample Data
    vec2 curJitter = camera.jitterData.xy * 0.5; // NDC to UV space
    vec2 preJitter = camera.jitterData.zw * 0.5;
    vec2 motion = texelFetch(gMotion, closestPixel, 0).xy;
    
    // Reprojection: current_unjittered_uv - motion = previous_unjittered_uv
    // previous_jittered_uv = previous_unjittered_uv + preJitter
    vec2 unjitteredUV = uv - curJitter; 
    vec2 prevUV = unjitteredUV - motion + preJitter;

    // Current frame sample (at jittered position)
    vec3 currentRGB = texelFetch(curColor, pixel, 0).rgb;
    vec3 currentYCoCg = RGBToYCoCg(ToneMap(currentRGB));

    // 3. Construct Stable AABB (at jittered position context)
    vec3 m1 = vec3(0.0);
    vec3 m2 = vec3(0.0);
    const ivec2 colorExtent = textureSize(curColor, 0);

    for (int x = -1; x <= 1; ++x) 
    {
        for (int y = -1; y <= 1; ++y) 
        {
            const ivec2 samplePixel =
                ClampPixel(pixel + ivec2(x, y), colorExtent);
            vec3 c = RGBToYCoCg(ToneMap(texelFetch(curColor, samplePixel, 0).rgb));
            m1 += c;
            m2 += c * c;
        }
    }
    
    // Variance-based box expansion
    vec3 mu = m1 / 9.0;
    vec3 sigma = sqrt(max(m2 / 9.0 - mu * mu, 0.0));
    
    float motionLen = length(motion * displayData.xy);
    
    // [ADJUST] Tighter box for more sharpness and less ghosting
    // Standard is ~1.5 to 2.0. Lower = sharper but more jittery.
    float varianceMultiplier = 1.5; 
    vec3 boxMin = mu - varianceMultiplier * sigma; 
    vec3 boxMax = mu + varianceMultiplier * sigma;
    
    // 4. Sample and Clip History
    const bool highQualityHistory =
        (frameData.w & RENDER_FLAG_TAA_HIGH_QUALITY_BIT) != 0;
    vec3 historyRGB = highQualityHistory
                          ? SampleHistoryCatmullRom(prevUV)
                          : texture(historyColor, prevUV).rgb;
    
    // [SAFETY] History NaN/Inf check
    if (any(isnan(historyRGB)) || any(isinf(historyRGB))) historyRGB = currentRGB;

    vec3 historyYCoCg = RGBToYCoCg(ToneMap(historyRGB));
    
    historyYCoCg = ClipHistory(historyYCoCg, boxMin, boxMax);

    // 5. Dynamic Alpha Blending
    // [ADJUST] Increased floor and sensitivity to kill ghosting
    float alpha = clamp(0.1 + motionLen * 0.1, 0.1, 0.9);

    const float currentDepth = texelFetch(gDepth, pixel, 0).r;
    const bool depthHistoryConsistent =
        IsDepthHistoryConsistent(unjitteredUV, prevUV, currentDepth);

    // Safety check: only accumulate if the history bit is explicitly set by the engine.
    const bool historyAvailable =
        (frameData.w & RENDER_FLAG_TAA_HISTORY_BIT) != 0;
    const bool historyAccepted = historyAvailable && depthHistoryConsistent;
    if (!historyAccepted) alpha = 1.0;

    if (frameData.z == DISPLAY_MODE_TAA_HISTORY)
    {
        // Green: history accepted. Red: first frame, out of bounds, or depth mismatch.
        const vec3 debugColor =
            historyAccepted ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
        imageStore(outFinal, pixel, vec4(debugColor, 1.0));
        return;
    }
    
    vec3 resolvedYCoCg = mix(historyYCoCg, currentYCoCg, alpha);
    vec3 resolvedRGB = UnToneMap(YCoCgToRGB(resolvedYCoCg));

    // [SAFETY] Final output check
    if (any(isnan(resolvedRGB)) || any(isinf(resolvedRGB))) resolvedRGB = currentRGB;

    imageStore(outFinal, pixel, vec4(resolvedRGB, 1.0));
}
