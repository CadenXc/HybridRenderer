#version 460
#extension GL_GOOGLE_include_directive : require
#include "../common/common.glsl"

layout(set = 2, binding = 0, rgba16f) uniform image2D rtShadowAO;
layout(set = 2, binding = 1) uniform sampler2D gNormal;
layout(set = 2, binding = 2) uniform sampler2D gDepth;

layout(location = 0) rayPayloadEXT HitPayload payload;

void main() 
{
    const vec2 inUV = (vec2(gl_LaunchIDEXT.xy) + vec2(0.5)) / vec2(gl_LaunchSizeEXT.xy);
    
    float depth = texture(gDepth, inUV).r;
    if (depth == 0.0) 
    {
        imageStore(rtShadowAO, ivec2(gl_LaunchIDEXT.xy), vec4(1.0));
        return;
    }

    // [FIX] Subtract TAA Jitter to reconstruct un-jittered world position
    // camera.jitterData.xy is in NDC space [-1, 1], so UV space is 0.5 scale.
    vec2 unjitteredUV = RemoveCameraJitter(inUV);
    vec3 worldPos = GetWorldPos(depth, unjitteredUV, camera.viewProjInverse);
    vec3 worldNormal = normalize(texture(gNormal, inUV).xyz);

    // 1. 使用蓝噪声获取随机采样点，并加入时间偏移以实现时域跳变
    // Use golden ratio or similar to offset noise every frame
    ivec2 noiseOffset = ivec2(frameData.y * 123, frameData.y * 456);
    vec4 blueNoise = GetBlueNoise(ivec2(gl_LaunchIDEXT.xy) + noiseOffset);
    vec2 randSample = blueNoise.xy;

    // 2. 计算软阴影采样方向
    vec3 lightDirection = normalize(-sunLight.direction.xyz);
    float lightRadius = sunLight.intensity.y; 
    lightDirection =
        SampleConeAroundDirection(lightDirection, lightRadius, randSample);

    // 3. 硬件光线追踪阴影
    float shadow = 1.0;
    bool lightEnabled = (frameData.w & RENDER_FLAG_LIGHT_BIT) != 0;
    bool shadowsEnabled = (frameData.w & RENDER_FLAG_SHADOW_BIT) != 0;
    if (lightEnabled && shadowsEnabled)
    {
        vec3 origin = OffsetRay(worldPos, worldNormal);
        
        payload.color_dist = vec4(0.0);
        payload.normal_rough = vec4(0.0);
        payload.motion_hit = vec4(0.0, 0.0, 1.0, 0.0); // b=1.0: Assume shadowed
        
        traceRayEXT(TLAS, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT | gl_RayFlagsSkipClosestHitShaderEXT,
                    0xFF, 0, 0, 1, origin, 0.001, lightDirection, 1e10, 0);
                    
        shadow = (payload.motion_hit.b > 0.5) ? 0.0 : 1.0;
    }

    imageStore(rtShadowAO, ivec2(gl_LaunchIDEXT.xy), vec4(vec3(shadow), 1.0));
}
